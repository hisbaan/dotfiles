#!/usr/bin/env bash

SESSION="server"
MONOREPO_DIR="$HOME/projects/monorepo"
LEGACY_DIR="$HOME/projects/affiniti"

CURRENT_DIR=$(pwd -P)

# Print the worktree of the bare repo at $1 that contains the cwd, or $1/$2 if none does.
worktree_dir() {
  local repo=$1 default=$2 name
  if [[ "$CURRENT_DIR" == "$repo"/* ]]; then
    name=${CURRENT_DIR#"$repo"/}
    name=${name%%/*}
    if [[ -e "$repo/$name/.git" ]]; then
      printf '%s\n' "$repo/$name"
      return
    fi
  fi
  printf '%s\n' "$repo/$default"
}

MONOREPO_MAIN_DIR=$(worktree_dir "$MONOREPO_DIR" main)
LEGACY_MAIN_DIR=$(worktree_dir "$LEGACY_DIR" develop)

tmux new-session -d -s "$SESSION" -n webhooks "TERM=xterm-256color zsh -ic 'cd \"$MONOREPO_MAIN_DIR/scripts\" && ./dev-webhooks.sh'"

tmux new-window -t "$SESSION:" -n accounts "zsh -ic 'cd \"$MONOREPO_MAIN_DIR/services/accounts\" && pn dev'"
tmux new-window -t "$SESSION:" -n applications "zsh -ic 'cd \"$MONOREPO_MAIN_DIR/services/applications\" && pn dev'"
tmux new-window -t "$SESSION:" -n customer "zsh -ic 'cd \"$MONOREPO_MAIN_DIR/apps/customer-dashboard\" && pn dev'"

tmux new-window -t "$SESSION:" -n legacy-api "zsh -ic 'cd \"$LEGACY_MAIN_DIR/api\" && yarn dev'"
tmux new-window -t "$SESSION:" -n internal "zsh -ic 'cd \"$LEGACY_MAIN_DIR/internal\" && yarn dev'"
